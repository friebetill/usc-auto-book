# USC Auto-Book Configuration
# Copy this file to .env and fill in your credentials

# ============================================================
# REQUIRED - User Credentials
# ============================================================
USC_EMAIL=your.email@example.com
USC_PASSWORD=your_password_here

# ============================================================
# REQUIRED - Booking Configuration
# ============================================================
# Find location IDs by inspecting network traffic in USC app/website
# Common locations: 15238 (example venue)
USC_LOCATION_ID=15238

# How many days in advance to book (14 = 2 weeks, USC max is typically 14)
USC_ADVANCE_DAYS=14

# Polling interval in seconds (1800 = 30 minutes)
# How often to check for available classes
USC_POLL_INTERVAL=1800

# Maximum hours to poll before giving up (default: 5)
# The script is designed to run daily at midnight via launchd/cron.
# It only processes bookings that open today, then exits.
USC_MAX_POLL_HOURS=5

# ============================================================
# OPTIONAL - OAuth Client Credentials
# ============================================================
# These are from the Android app (publicly known, generally static)
# Default values work for most users - only change if USC updates their app
USC_CLIENT_ID=86093282310
USC_CLIENT_SECRET=1BJX3V5HWUYVCZ77S1TY9L1PSWAXA3K95ZMUC3ZRBAP3M696ZF4SD3QW5VBNU81H

# ============================================================
# OPTIONAL - API Configuration
# ============================================================
USC_API_BASE_URL=https://api.urbansportsclub.com/api/v6

# ============================================================
# OPTIONAL - HTTP Headers
# ============================================================
# Mimics Android app (helps avoid detection as bot)
USC_USER_AGENT=USCAPP/4.0.8 (android; 28; Scale/2.75)
USC_ACCEPT_ENCODING=gzip, deflate
USC_ACCEPT_LANGUAGE=en-US;q=1.0

# ============================================================
# OPTIONAL - Class Filters
# ============================================================
# Leave empty to disable filtering (will book first available class)

# Target day of week for primary booking (0=Monday, 6=Sunday)
# The tool finds this weekday within the advance booking window
USC_TARGET_DAY=0

# Class title filter (case-insensitive substring match)
# Examples: "yoga", "pilates", "crossfit"
USC_CLASS_TITLE_FILTER=

# Instructor name filter (case-insensitive substring match)
# Example: "John Smith"
USC_INSTRUCTOR_FILTER=

# Time range filters (24-hour format: HH:MM)
# Only book classes within this time window
# Examples:
#   Morning classes: USC_TIME_RANGE_START=06:00, USC_TIME_RANGE_END=12:00
#   Evening classes: USC_TIME_RANGE_START=18:00, USC_TIME_RANGE_END=21:00
USC_TIME_RANGE_START=
USC_TIME_RANGE_END=

# ============================================================
# OPTIONAL - Logging Configuration
# ============================================================
# Log level: DEBUG, INFO, WARNING, ERROR
# DEBUG: Shows detailed filter matching and API calls
# INFO: Shows booking progress and results (recommended)
# WARNING: Only shows issues
# ERROR: Only shows errors
USC_LOG_LEVEL=INFO

# Log file path (leave empty for console output only)
# Recommended for cron jobs: /path/to/usc-auto-book.log
# The directory must exist and be writable
USC_LOG_FILE=

# ============================================================
# OPTIONAL - Additional Bookings (for User 1)
# ============================================================
# Add extra booking jobs using USC_BOOKING_N_* prefix (N=2,3,...)
# Each additional booking needs at least LOCATION_ID.
# Other fields default to empty/0 if omitted.
#
# Example — Booking 2 (Thursday at a different location):
# USC_BOOKING_2_LOCATION_ID=20096
# USC_BOOKING_2_TARGET_DAY=3
# USC_BOOKING_2_CLASS_TITLE_FILTER=level 3
# USC_BOOKING_2_INSTRUCTOR_FILTER=
# USC_BOOKING_2_TIME_RANGE_START=
# USC_BOOKING_2_TIME_RANGE_END=

# ============================================================
# OPTIONAL - Additional Users
# ============================================================
# Add more users with USC_USER_N_* prefix (N=2,3,...).
# User 1 is always the primary user (uses USC_EMAIL, USC_PASSWORD above).
# Users are processed in order — User 1 books first and gets priority.
#
# Each user needs at least EMAIL, PASSWORD, and LOCATION_ID.
# Optional USC_USER_N_NAME for friendly logging (defaults to "User N").
# Additional bookings per user: USC_USER_N_BOOKING_M_* (M=2,3,...).
#
# Example — User 2:
# USC_USER_2_NAME=Friend
# USC_USER_2_EMAIL=friend@example.com
# USC_USER_2_PASSWORD=their_password_here
# USC_USER_2_LOCATION_ID=20096
# USC_USER_2_TARGET_DAY=3
# USC_USER_2_CLASS_TITLE_FILTER=level 3
# USC_USER_2_INSTRUCTOR_FILTER=
# USC_USER_2_TIME_RANGE_START=
# USC_USER_2_TIME_RANGE_END=
#
# User 2's additional bookings:
# USC_USER_2_BOOKING_2_LOCATION_ID=...
# USC_USER_2_BOOKING_2_TARGET_DAY=...
